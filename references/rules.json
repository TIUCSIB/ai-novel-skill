{
  "version": 1,
  "note": "分级去 AI 味规则库(仿 neuro-book llmlint 的规则模型)。mode=ban 可入黑名单(字面/正则命中即改);mode=watch 只察不禁(单词合法、频率成病,密度判定交给 style_stats)。level 三档递增:core=写作时必守,standard=审校时加查,wide=全书清底时才用。init-voice 只种 ban 规则(core+standard 档)。",
  "cats": {
    "face":   {"name": "神情套装词", "guide": "眼睛/嘴角/脸上的固定搭配是 AI 味第一重灾区。改法:不写表情,写表情导致的动作与视线落点(他把鱼肚子上那块肉拨进她碗里)。"},
    "body":   {"name": "身体反应套装", "guide": "震/缩/滞这类全身反应词,一次有效、十次成腔。改法:写局部的、不体面的身体细节(膝盖先着地,人还没倒)。"},
    "mood":   {"name": "气氛套话与明喻", "guide": "空气凝固/落针可闻是给读者的情绪说明书。改法:写现场里没人管的具体事物(炉上的水开了,咕嘟了半天,没人去提)。仿佛/宛如单独合法,密度闸门交 style_stats。"},
    "psych":  {"name": "心理直写", "guide": "心中一动/感到一阵XX 是演完了又旁白一遍。改法:情绪交给动作与生理(指节抵着桌面,慢慢泛白)。"},
    "pacer":  {"name": "节奏加速器", "guide": "瞬间/猛地/陡然单独都合法,病在频率——每一次转折都靠它加速,说明没有一次是靠动作本身完成的。改法:删掉加速器,把动作写清楚。密度闸门在 style_stats(>2.5/千字)。"},
    "conn":   {"name": "章法连接词", "guide": "然而/与此同时是段落间的万能搭扣,真人转场用空行+地点时间锚(灵木峰。夜。)。密度闸门在 style_stats(>1.0/千字)。"},
    "syntax": {"name": "句式病", "guide": "不是X而是Y、在……的瞬间、三连排比 —— 模式层面的病,换词逃不掉。改法是拆句、砍到一层。"},
    "echo":   {"name": "复述类", "guide": "已经演出来的东西再用语言总结一遍(情绪总结/主题总结/对话后翻译潜台词)。计数闸门在 style_stats,改写对照 ai-taste.md 一~五节。"},
    "talk":   {"name": "对话腔套话", "guide": "闻言/话音刚落/此言一出是 AI 给对话挂的报幕员。改法:让下一个人的动作接话,而不是叙述替对话加旁白。"},
    "infl":   {"name": "修辞通胀", "guide": "深不可测/惊天动地/倒吸凉气 —— 形容词花光了的标志。改法:给可测的侧面、写具体的连锁反应。"},
    "filler": {"name": "说教与总结语", "guide": "总之/由此可见/值得注意的是是议论文残留,小说里一律删,让事件自己说话。"},
    "end":    {"name": "章末三禁", "guide": "总结/反问/抒情升华收尾违反章末三禁。改法:切下一场的第一个动作,或半截对话、突转画面。"},
    "trans":  {"name": "翻译腔", "guide": "中文原生的故事里不该有英文句法的幽灵。确需翻译腔人设(如外语角色)可破例,记在 voice.md。"},
    "pov":    {"name": "视角越权", "guide": "叙述提前泄露视角人物不知道的事=烧悬念。他不知道的是每卷至多 1 次。"}
  },
  "rules": [
    {"id": "face-yisi", "cat": "face", "level": "core", "mode": "ban", "kind": "word", "pat": "一丝", "hint": "一丝+抽象名词=套装描写,整句重写"},
